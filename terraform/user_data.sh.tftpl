#!/bin/bash
# Bootstrap dell'istanza: Docker + GPU, servizio systemd del chatbot.
# Log: /var/log/chatbot-bootstrap.log
set -euxo pipefail
exec > >(tee -a /var/log/chatbot-bootstrap.log) 2>&1

APP_DIR=/opt/chatbot
CONF_DIR=/etc/chatbot
GIT_REPO_URL="${git_repo_url}"
GIT_BRANCH="${git_branch}"

export DEBIAN_FRONTEND=noninteractive

# --- Docker, Compose e NVIDIA Container Toolkit (già presenti sulla Deep Learning AMI) ---
if ! command -v docker >/dev/null; then
  curl -fsSL https://get.docker.com | sh
fi
if ! docker compose version >/dev/null 2>&1; then
  apt-get update && apt-get install -y docker-compose-plugin
fi
if ! command -v nvidia-ctk >/dev/null; then
  curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey \
    | gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
  curl -fsSL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list \
    | sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' \
    > /etc/apt/sources.list.d/nvidia-container-toolkit.list
  apt-get update && apt-get install -y nvidia-container-toolkit
fi
if ! command -v aws >/dev/null; then
  snap install aws-cli --classic
fi

nvidia-ctk runtime configure --runtime=docker
systemctl restart docker
systemctl enable docker
usermod -aG docker ubuntu

# --- Cartelle ---
mkdir -p "$APP_DIR" "$CONF_DIR"
chown ubuntu:ubuntu "$APP_DIR"

if [ -n "$GIT_REPO_URL" ] && [ -z "$(ls -A "$APP_DIR")" ]; then
  sudo -u ubuntu git clone --branch "$GIT_BRANCH" "$GIT_REPO_URL" "$APP_DIR"
fi
mkdir -p "$APP_DIR/documents"
chown ubuntu:ubuntu "$APP_DIR/documents"

# --- Override Compose: GPU per il container Ollama ---
cat > "$CONF_DIR/docker-compose.gpu.yml" <<'EOF'
services:
  ollama:
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
EOF

# --- Script di avvio: legge config e segreti da SSM e lancia lo stack ---
cat > /usr/local/bin/chatbot-start.sh <<'EOF'
#!/bin/bash
set -euo pipefail

# Parametri SSM esportati come variabili d'ambiente: hanno la precedenza
# su un eventuale .env nella cartella del progetto.
# Lettura separata dal loop: se aws fallisce, set -e ferma lo script.
PARAMS=$(aws ssm get-parameters-by-path \
  --region "${aws_region}" \
  --path "${ssm_prefix}" \
  --with-decryption \
  --query 'Parameters[*].[Name,Value]' \
  --output text)
while IFS=$'\t' read -r name value; do
  export "$${name##*/}=$value"
done <<< "$PARAMS"

cd /opt/chatbot
COMPOSE="docker compose -f docker-compose.yml%{ if enable_gpu } -f /etc/chatbot/docker-compose.gpu.yml%{ endif }"
$COMPOSE up -d --build

if [ "$${LLM_PROVIDER:-ollama}" = "ollama" ]; then
  until $COMPOSE exec -T ollama ollama list >/dev/null 2>&1; do sleep 3; done
  $COMPOSE exec -T ollama ollama pull "$OLLAMA_MODEL"
fi
EOF

cat > /usr/local/bin/chatbot-stop.sh <<'EOF'
#!/bin/bash
set -euo pipefail
cd /opt/chatbot
docker compose -f docker-compose.yml%{ if enable_gpu } -f /etc/chatbot/docker-compose.gpu.yml%{ endif } down
EOF

chmod +x /usr/local/bin/chatbot-start.sh /usr/local/bin/chatbot-stop.sh

# --- Servizio systemd ---
cat > /etc/systemd/system/chatbot.service <<'EOF'
[Unit]
Description=Chatbot RAG (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/chatbot/docker-compose.yml

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/chatbot-start.sh
ExecStop=/usr/local/bin/chatbot-stop.sh
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable chatbot.service

# Parte subito se il codice è già presente (git clone); altrimenti va avviato
# a mano dopo la copia: sudo systemctl start chatbot
if [ -f "$APP_DIR/docker-compose.yml" ]; then
  systemctl start --no-block chatbot.service
fi
