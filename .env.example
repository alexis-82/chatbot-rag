# Provider LLM: ollama | anthropic | openai
LLM_PROVIDER=ollama

# --- Ollama (locale) ---
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- Anthropic (cloud) ---
# Ottieni una API key su https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- OpenAI (cloud) ---
# Ottieni una API key su https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings (sempre locali, indipendenti dal provider LLM) ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Storage & retrieval ---
CHROMA_DIR=./chroma_db
DOCS_DIR=./documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
